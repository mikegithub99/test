#!/usr/bin/env bash
# Build and install 32-bit hiredis 1.2.0 and redis-plus-plus 1.3.15
# on RHEL 8 x86_64, installing under /opt/redis32.
set -Eeuo pipefail

PREFIX="${PREFIX:-/opt/redis32}"
HIREDIS_VERSION="${HIREDIS_VERSION:-1.2.0}"
REDIS_PLUS_PLUS_VERSION="${REDIS_PLUS_PLUS_VERSION:-1.3.15}"
BUILD_DIR="${BUILD_DIR:-/usr/local/src/redis32-build}"
JOBS="${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)}"

if [[ "$(uname -m)" != "x86_64" ]]; then
  echo "ERROR: This script expects an x86_64 host." >&2
  exit 1
fi
if [[ $EUID -ne 0 ]]; then
  echo "ERROR: Run as root (for example: sudo $0)." >&2
  exit 1
fi

if ! command -v dnf >/dev/null 2>&1; then
  echo "ERROR: dnf was not found; this script is intended for RHEL 8." >&2
  exit 1
fi

echo "Installing build tools and 32-bit development libraries..."
dnf install -y gcc gcc-c++ make cmake git curl tar gzip glibc-devel.i686 libstdc++-devel.i686

mkdir -p "$BUILD_DIR" "$PREFIX"
cd "$BUILD_DIR"

fetch_and_unpack() {
  local name="$1" version="$2" url="$3"
  if [[ ! -d "$name-$version" ]]; then
    curl -fL --retry 3 "$url" -o "$name-$version.tar.gz"
    tar -xzf "$name-$version.tar.gz"
  fi
}

fetch_and_unpack hiredis "$HIREDIS_VERSION" \
  "https://github.com/redis/hiredis/archive/refs/tags/v${HIREDIS_VERSION}.tar.gz"
fetch_and_unpack redis-plus-plus "$REDIS_PLUS_PLUS_VERSION" \
  "https://github.com/sewenew/redis-plus-plus/archive/refs/tags/${REDIS_PLUS_PLUS_VERSION}.tar.gz"

echo "Building hiredis ${HIREDIS_VERSION} as 32-bit..."
cmake -S "$BUILD_DIR/hiredis-$HIREDIS_VERSION" \
  -B "$BUILD_DIR/hiredis-$HIREDIS_VERSION/build32" \
  -DCMAKE_INSTALL_PREFIX="$PREFIX" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_FLAGS="-m32" \
  -DCMAKE_SHARED_LINKER_FLAGS="-m32" \
  -DCMAKE_EXE_LINKER_FLAGS="-m32" \
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
  -DDISABLE_TESTS=ON
cmake --build "$BUILD_DIR/hiredis-$HIREDIS_VERSION/build32" --parallel "$JOBS"
cmake --install "$BUILD_DIR/hiredis-$HIREDIS_VERSION/build32"

echo "Building redis-plus-plus ${REDIS_PLUS_PLUS_VERSION} as 32-bit..."
cmake -S "$BUILD_DIR/redis-plus-plus-$REDIS_PLUS_PLUS_VERSION" \
  -B "$BUILD_DIR/redis-plus-plus-$REDIS_PLUS_PLUS_VERSION/build32" \
  -DCMAKE_INSTALL_PREFIX="$PREFIX" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_CXX_STANDARD=17 \
  -DCMAKE_CXX_FLAGS="-m32 -D_GLIBCXX_USE_CXX11_ABI=0" \
  -DCMAKE_C_FLAGS="-m32" \
  -DCMAKE_SHARED_LINKER_FLAGS="-m32" \
  -DCMAKE_EXE_LINKER_FLAGS="-m32" \
  -DCMAKE_PREFIX_PATH="$PREFIX" \
  -DCMAKE_LIBRARY_PATH="$PREFIX/lib;$PREFIX/lib64" \
  -DCMAKE_INCLUDE_PATH="$PREFIX/include" \
  -DREDIS_PLUS_PLUS_BUILD_TEST=OFF \
  -DREDIS_PLUS_PLUS_BUILD_STATIC=OFF
cmake --build "$BUILD_DIR/redis-plus-plus-$REDIS_PLUS_PLUS_VERSION/build32" --parallel "$JOBS"
cmake --install "$BUILD_DIR/redis-plus-plus-$REDIS_PLUS_PLUS_VERSION/build32"

cat > /etc/ld.so.conf.d/redis32.conf <<EOF
$PREFIX/lib
$PREFIX/lib64
EOF
ldconfig

echo
echo "Install finished under $PREFIX"
echo "If your application needs the libraries at runtime, ensure it uses 32-bit libraries and"
echo "links with -L$PREFIX/lib -Wl,-rpath,$PREFIX/lib (adjust to lib64 if applicable)."
